# .clang-tidy - clang-tidy configuration for SneezyMUD 2.5 (C++20)
# Run with: python3 scripts/analyze.py run
#
# This is a C codebase compiled as C++20. The checks are tuned to catch real bugs
# while avoiding excessive noise from C-style patterns that work fine in C++.
#
# Requires: clang-tidy 17+ for misc-include-cleaner
#
# Disabled check explanations:
#   - Platform/library-specific: abseil, altera, android, boost, darwin, fuchsia, linuxkernel, llvmlibc, mpi, objc, openmp, zircon
#   - Style preferences: llvm-* (LLVM-specific), google-* (Google style)
#   - Would require major refactoring:
#       cert-err58-cpp (static init order),
#       cppcoreguidelines-avoid-non-const-global-variables (globals everywhere),
#       cppcoreguidelines-non-private-member-variables-in-classes (C structs),
#       misc-non-private-member-variables-in-classes (same)
#   - Too noisy for legacy C code compiled as C++:
#       bugprone-easily-swappable-parameters (many false positives in C APIs),
#       cppcoreguidelines-pro-type-reinterpret-cast (C-style pointer manipulation),
#       cppcoreguidelines-pro-type-cstyle-cast (C casts everywhere),
#       cppcoreguidelines-pro-bounds-pointer-arithmetic (idiomatic in C),
#       cppcoreguidelines-pro-bounds-array-to-pointer-decay (C arrays),
#       cppcoreguidelines-avoid-c-arrays (this IS a C codebase),
#       cppcoreguidelines-avoid-magic-numbers (same as readability-magic-numbers),
#       cppcoreguidelines-owning-memory (no gsl:: in this project),
#       cppcoreguidelines-no-malloc (intentionally using malloc),
#       hicpp-* (mostly duplicates cppcoreguidelines, plus hicpp-signed-bitwise is noisy),
#       modernize-* (would rewrite entire codebase),
#       readability-function-cognitive-complexity (legacy code has complex functions),
#       readability-identifier-length (short names like 'i', 'ch' are idiomatic),
#       readability-magic-numbers (would flag nearly every number literal),
#       readability-implicit-bool-conversion (C-style boolean usage),
#       readability-named-parameter (unnamed params common in C),
#       misc-no-recursion (recursion is used intentionally)
#   - Security/randomness (intentionally relaxed for game):
#       cert-msc30-c, cert-msc32-c, cert-msc50-cpp, cert-msc51-cpp (rand() acceptable for game RNG)
#   - Concurrency (no threading in this codebase): concurrency-*
#   - C++23 only: modernize-use-std-print

---
HeaderFilterRegex: 'code/.*'

Checks: >
  *,
  misc-header-include-cycle,
  misc-include-cleaner,
  -abseil-*,
  -altera-*,
  -android-*,
  -boost-*,
  -bugprone-easily-swappable-parameters,
  -cert-err58-cpp,
  -cert-msc30-c,
  -cert-msc32-c,
  -cert-msc50-cpp,
  -cert-msc51-cpp,
  -concurrency-*,
  -darwin-*,
  -fuchsia-*,
  -google-*,
  -hicpp-*,
  -linuxkernel-*,
  -llvm-header-guard,
  -llvm-include-order,
  -llvm-namespace-comment,
  -llvmlibc-*,
  -misc-no-recursion,
  -modernize-use-trailing-return-type,
  -mpi-*,
  -objc-*,
  -openmp-*,
  -readability-identifier-length,
  -readability-named-parameter,
  -zircon-*,

CheckOptions:
  # Allow short names for loop variables and common idioms
  - key: readability-identifier-length.MinimumVariableNameLength
    value: 1
  - key: readability-identifier-length.MinimumParameterNameLength
    value: 1

  # Reasonable thresholds for complexity checks (if re-enabled)
  - key: readability-function-cognitive-complexity.Threshold
    value: 100
  - key: readability-function-size.LineThreshold
    value: 500

  # Performance check configuration
  - key: performance-for-range-copy.WarnOnAllAutoCopies
    value: true
  - key: performance-inefficient-string-concatenation.StrictMode
    value: true

# Production-critical checks surfaced as errors in IDE
# Criteria: issues likely to cause crashes, memory/data corruption, or invalid game state
WarningsAsErrors: >
  bugprone-assert-side-effect,
  bugprone-bool-pointer-implicit-conversion,
  bugprone-dangling-handle,
  bugprone-exception-escape,
  bugprone-inaccurate-erase,
  bugprone-infinite-loop,
  bugprone-integer-division,
  bugprone-misplaced-widening-cast,
  bugprone-multi-level-implicit-pointer-conversion,
  bugprone-not-null-terminated-result,
  bugprone-parent-virtual-call,
  bugprone-signal-handler,
  bugprone-signed-char-misuse,
  bugprone-sizeof-expression,
  bugprone-string-constructor,
  bugprone-suspicious-memset-usage,
  bugprone-suspicious-semicolon,
  bugprone-suspicious-string-compare,
  bugprone-swapped-arguments,
  bugprone-throw-keyword-missing,
  bugprone-undelegated-constructor,
  bugprone-undefined-memory-manipulation,
  bugprone-unhandled-self-assignment,
  bugprone-unused-raii,
  bugprone-use-after-move,
  bugprone-virtual-near-miss
